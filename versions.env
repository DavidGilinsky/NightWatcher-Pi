# ---------------------------------------------------------------------------
# Author:        David Gilinsky
# File:          versions.env
# Purpose:       Every pinned input to an image build in one place: the
#                NightWatcher2 package, the pi-gen revision, the Raspberry Pi OS
#                release, and the appliance defaults baked into the image.
#                Change a value here, rebuild, and the image is different in
#                exactly that way.
# Created:       2026-07-27
# Last Modified: 2026-07-27
# Version:       0.1.0
# License:       GPL-3.0-or-later
# ---------------------------------------------------------------------------

# ---- this image ----
NWPI_VERSION=0.1.0
IMG_NAME=nightwatcher-pi

# ---- NightWatcher2 (the application the image delivers) ----
# The release tag to install. `make deb` downloads the arm64 package from this
# release and verifies it against the release's SHA256SUMS. Override the whole
# lookup with NW2_DEB=/path/to/nightwatcher_x.y.z_arm64.deb when testing a build
# that has not been released yet.
NW2_REPO=DavidGilinsky/NightWatcher2
NW2_VERSION=v0.1.0

# ---- base image (pi-gen) ----
# The arm64 branch is what builds 64-bit images; master builds armhf. Pinned to
# a commit so an image built next year is the image built today.
PIGEN_REPO=https://github.com/RPi-Distro/pi-gen.git
PIGEN_BRANCH=arm64
PIGEN_REF=ca8aeed0ae300c2a89f55ce9617d5f96a27e99e5
RELEASE=trixie

# ---- appliance defaults ----
# The access point is always on. The SSID suffix is derived per unit on first
# boot from the last 4 bytes of the wlan0 MAC, so only the prefix is set here.
AP_SSID_PREFIX=nightwatcher
# Fleet default passphrase. Documented, changeable per unit from the web UI's
# RPi tab, and deliberately not per-unit random: a volunteer with an SD card in
# hand can read the docs, but cannot read a passphrase generated after the card
# was already in a sealed enclosure.
AP_PASSPHRASE=nightwatcher
AP_ADDRESS=192.168.4.1/24
AP_CHANNEL=6
# Regulatory domain. Wrong or unset, the radio will not come up in AP mode.
WIFI_COUNTRY=US
# Southern Arizona Dark Sky Network sites are all in one zone; a unit can be
# re-zoned from the UI later.
TIMEZONE_DEFAULT=America/Phoenix
LOCALE_DEFAULT=en_US.UTF-8
KEYBOARD_KEYMAP=us

# ---- recovery access ----
# A documented fleet default, deliberately, on the same reasoning as the access
# point passphrase: a per-unit random password is more secure and unusable in
# the field. It can only be read from the boot partition, and on a Compute
# Module that means another rpiboot session, so a volunteer standing at a unit
# with a monitor and keyboard could not log in to the machine in front of them.
#
# The consequence is real and worth stating: this password is the same on every
# unit built from this image, and SSH is enabled. Anyone within radio range who
# knows the defaults has a sudo-capable shell. Sites that need better should
# change it per unit (`passwd` over SSH), or disable password authentication
# and deploy keys.
#
# The database password is NOT like this: it is generated per unit on first
# boot, because nobody ever needs to type it.
FIRST_USER_NAME=nightwatcher
FIRST_USER_PASS=nightwatcher
ENABLE_SSH=1
