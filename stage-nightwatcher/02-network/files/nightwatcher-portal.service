# ---------------------------------------------------------------------------
# Author:        David Gilinsky
# File:          /etc/systemd/system/nightwatcher-portal.service
# Purpose:       Install the best-effort 443 -> 8080 redirect once the access
#                point is up. Never fails the boot: the web UI's own port works
#                with or without it.
# Created:       2026-07-27
# Last Modified: 2026-07-27
# Version:       0.1.0
# License:       GPL-3.0-or-later
# ---------------------------------------------------------------------------
[Unit]
Description=NightWatcher appliance web UI port redirect (443 -> 8080)
After=nightwatcher-ap.service
Wants=nightwatcher-ap.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/nightwatcher-pi/nw-portal.sh

[Install]
WantedBy=multi-user.target
